# Helm-values сервиса __NAME__ для общего чарта deploy/charts/service.
# Секреты в git не хранятся: Secret `__NAME__-secrets` создаёт `make k8s-dev-secrets` / CI/CD / Vault.
name: __NAME__
image:
  repository: food/__NAME__
  tag: dev
port: __PORT__
replicas: 2
env:
  APP_ENV: dev
  LOG_LEVEL: info
  AUTH_MODE: jwks # личность — только из JWT, проверенного локально по JWKS (ADR-11)
  AUTH_JWKS_URL: http://auth/auth/.well-known/jwks.json
  KAFKA_BROKERS: kafka:9092
existingSecret: __NAME__-secrets # ключи: DATABASE_URL
migrations:
  enabled: true # Job `__NAME__-service --migrate-only` (pre-install/pre-upgrade hook)
resources:
  requests: { cpu: 50m, memory: 64Mi }
  limits: { memory: 192Mi }
ingress:
  paths: [] # снаружи сервис доступен только через gateway (маршрут добавляется в routes.json и contracts/openapi/gateway.yaml)
