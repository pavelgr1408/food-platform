{
  "name": "lotok",
  "version": "0.1.0",
  "color": {
    "tomato": { "value": "#D62A16", "role": "hero, active, promo; text on it only white (5.0:1)" },
    "lemon": { "value": "#FFD43B", "role": "price, primary call; text on it only ink (13.0:1)" },
    "ink": { "value": "#12131A", "role": "text, primary buttons" },
    "paper": { "value": "#F3F4FB", "role": "page background" },
    "white": { "value": "#FFFFFF", "role": "cards" },
    "mint": { "value": "#1FBF84", "role": "ready, success; text ink (7.8:1)" },
    "coral": { "value": "#FF5A4D", "role": "declined, error; fill only, text ink (6.0:1)" },
    "textMuted": { "value": "#3F4254", "role": "secondary text (9.0:1 on paper)" },
    "textDisabled": { "value": "#6A6D80", "role": "inactive steps (4.7:1 on paper)" }
  },
  "font": {
    "display": { "family": "Unbounded", "weights": [500, 600], "use": "headings, prices, hero" },
    "body": { "family": "Onest", "weights": [400, 500, 600], "use": "text, controls" }
  },
  "fontSize": { "hero": 56, "h1": 44, "h2": 26, "price": 18, "body": 16, "small": 13 },
  "radius": { "card": 28, "tile": 20, "input": 14, "pill": 999 },
  "space": [4, 8, 12, 16, 24, 32, 48],
  "tap": { "min": 48, "cta": 58 },
  "breakpoints": { "sm": 480, "md": 768, "lg": 1024, "xl": 1280 },
  "orderStatus": {
    "pending_payment": { "bg": "transparent", "fg": "#12131A", "border": "#12131A" },
    "accepted": { "bg": "transparent", "fg": "#12131A", "border": "#12131A" },
    "cooking": { "bg": "#FFD43B", "fg": "#12131A" },
    "ready": { "bg": "#1FBF84", "fg": "#12131A" },
    "on_delivery": { "bg": "#D62A16", "fg": "#FFFFFF" },
    "delivered": { "bg": "#12131A", "fg": "#FFFFFF" },
    "payment_declined": { "bg": "#FF5A4D", "fg": "#12131A" }
  }
}
