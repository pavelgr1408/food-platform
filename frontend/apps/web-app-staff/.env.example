# real | mock. mock — MSW-моки по OpenAPI (бэкенд не нужен). Для mock удобнее: npm run dev:mock
VITE_API_MODE=real
# Куда ходит браузер. /api — dev-proxy Vite → GATEWAY_URL (CORS не нужен).
VITE_API_BASE_URL=/api
# Адрес gateway для dev-proxy (читает vite.config.ts, в бандл не попадает)
GATEWAY_URL=http://localhost:8080
