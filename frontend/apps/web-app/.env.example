# real | mock. mock — MSW-моки по OpenAPI (бэкенд не нужен). Для mock удобнее: npm run dev:mock
VITE_API_MODE=real
# Куда ходит браузер. /api — dev-proxy Vite → GATEWAY_URL (рекомендуется, CORS не нужен).
# Прямой gateway: VITE_API_BASE_URL=http://localhost:8080 (нужен CORS_ALLOWED_ORIGINS=http://localhost:3000 и DELETE из fix-gateway-cors-delete)
VITE_API_BASE_URL=/api
# Адрес gateway для dev-proxy (read by vite.config.ts, не попадает в бандл)
GATEWAY_URL=http://localhost:8080
# redirect (прод): уход на страницу банка и возврат по returnUrl.
# poll (локальный стенд с mock-externals): остаёмся на странице заказа, итог приходит вебхуком за ~2 с.
VITE_PAYMENT_MODE=poll
