{
  "name": "web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "e2e": "playwright test",
    "dev:mock": "VITE_API_MODE=mock vite",
    "build:mock": "tsc --noEmit && VITE_API_MODE=mock vite build",
    "preview:mock": "VITE_API_MODE=mock vite preview"
  },
  "dependencies": {
    "@fp/api": "*",
    "@fp/design-tokens": "*",
    "@fp/shared": "*",
    "@tanstack/react-query": "5.106.1",
    "leaflet": "^1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.0",
    "@types/leaflet": "^1.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "31.0.0",
    "msw": "3.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
