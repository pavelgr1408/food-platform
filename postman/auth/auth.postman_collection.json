      "name": "0. Служебные",
      "item": [
        {
          "name": "GET /actuator/health (readiness, проверяет БД)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Готовность: сервис + ping Postgres. Это же использует compose/k8s readiness."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 UP', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('UP'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/.well-known/jwks.json (публичный ключ RS256)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/.well-known/jwks.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                ".well-known",
                "jwks.json"
              ]
            },
            "description": "Gateway (ADR-11) и сервисы проверяют JWT локально по этому набору ключей."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const k = pm.response.json().keys;",
                  "pm.test('один RSA/RS256 ключ с kid, n, e', () => {",
                  "  pm.expect(k).to.be.an('array').with.lengthOf.at.least(1);",
                  "  pm.expect(k[0].kty).to.eql('RSA'); pm.expect(k[0].alg).to.eql('RS256'); pm.expect(k[0].use).to.eql('sig');",
                  "  pm.expect(k[0].kid).to.be.a('string').and.not.empty; pm.expect(k[0].n).to.be.a('string').and.not.empty; pm.expect(k[0].e).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('в JWKS нет приватных полей', () => ['d','p','q','dp','dq','qi'].forEach(f => pm.expect(k[0]).to.not.have.property(f)));",
                  "pm.collectionVariables.set('jwksKid', k[0].kid);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Сценарий: регистрация → вход → me → refresh → logout",
      "item": [
        {
          "name": "1.1 POST /auth/register — регистрация",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Телефон в формате E.164 (+79991234567), пароль 6–72 символа. Новому пользователю выдаётся роль CUSTOMER."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Уникальный телефон на каждый прогон (E.164): +7999 + 7 цифр. Повторный запуск не упирается в 409.",
                  "if (!pm.collectionVariables.get('phone') || pm.collectionVariables.get('phoneFixed') !== 'true') {",
                  "  const n = String(Math.floor(Math.random() * 1e7)).padStart(7, '0');",
                  "  pm.collectionVariables.set('phone', '+7999' + n);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('userId (uuid), phone, status=ACTIVE', () => {",
                  "  pm.expect(b.userId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);",
                  "  pm.expect(b.phone).to.eql(pm.collectionVariables.get('phone'));",
                  "  pm.expect(b.status).to.eql('ACTIVE');",
                  "});",
                  "pm.test('пароль/хэш не возвращаются', () => pm.expect(JSON.stringify(b)).to.not.match(/password/i));",
                  "pm.collectionVariables.set('userId', b.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 POST /auth/login — вход по телефону и паролю",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test('пара токенов', () => {",
                  "  pm.expect(t.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(t.refreshToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(t.tokenType).to.match(/^bearer$/i);",
                  "  pm.expect(t.expiresIn).to.be.a('number').and.above(0);",
                  "});",
                  "pm.test('access — JWT RS256 с kid из JWKS, sub = userId', () => {",
                  "  const parts = t.accessToken.split('.'); pm.expect(parts).to.have.lengthOf(3);",
                  "  const h = JSON.parse(atob(parts[0].replace(/-/g,'+').replace(/_/g,'/')));",
                  "  let p = parts[1].replace(/-/g,'+').replace(/_/g,'/'); while (p.length % 4) p += '=';",
                  "  const c = JSON.parse(atob(p));",
                  "  pm.expect(h.alg).to.eql('RS256');",
                  "  const kid = pm.collectionVariables.get('jwksKid'); if (kid) pm.expect(h.kid).to.eql(kid);",
                  "  pm.expect(c.sub).to.eql(pm.collectionVariables.get('userId'));",
                  "  pm.expect(c.roles).to.include('CUSTOMER');",
                  "});",
                  "pm.collectionVariables.set('accessToken', t.accessToken);",
                  "pm.collectionVariables.set('refreshToken', t.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 GET /auth/me — текущий пользователь",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
