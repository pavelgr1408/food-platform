          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('userId/phone/roles/status', () => {",
                  "  pm.expect(b.userId).to.eql(pm.collectionVariables.get('userId'));",
                  "  pm.expect(b.phone).to.eql(pm.collectionVariables.get('phone'));",
                  "  pm.expect(b.roles).to.include('CUSTOMER'); pm.expect(b.status).to.eql('ACTIVE');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 POST /auth/introspect — access-токен активен",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/introspect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "introspect"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{accessToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Для сервисов, которым нужна онлайн-проверка (в отличие от локальной проверки по JWKS)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('active=true, userId, roles', () => {",
                  "  pm.expect(b.active).to.eql(true);",
                  "  pm.expect(b.userId).to.eql(pm.collectionVariables.get('userId'));",
                  "  pm.expect(b.roles).to.include('CUSTOMER');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 POST /auth/refresh — ротация refresh-токена",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Одноразовый refresh: старый токен отзывается, выдаётся новая пара."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test('выданы новые токены', () => {",
                  "  pm.expect(t.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(t.refreshToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(t.refreshToken).to.not.eql(pm.collectionVariables.get('refreshToken'));",
                  "});",
                  "pm.collectionVariables.set('oldRefreshToken', pm.collectionVariables.get('refreshToken'));",
                  "pm.collectionVariables.set('accessToken', t.accessToken);",
                  "pm.collectionVariables.set('refreshToken', t.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.6 POST /auth/refresh — повтор старого токена отклонён",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{oldRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Защита от повторного использования: старый refresh после ротации недействителен."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 401', () => pm.response.to.have.status(401));",
                  "pm.test('application/problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));",
                  "const e = pm.response.json();",
                  "pm.test('Problem: type/title/status/detail/instance/code', () => {",
                  "  pm.expect(e).to.include.all.keys('type','title','status','detail','instance','code');",
                  "  pm.expect(e.status).to.eql(401);",
                  "});",
                  "pm.test('code = INVALID_REFRESH_TOKEN', () => pm.expect(e.code).to.eql('INVALID_REFRESH_TOKEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.7 POST /auth/logout — выход (отзыв refresh)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
