{
  "info": {
    "name": "notification-service",
    "description": "S9: регистрация push-токенов (registerDeviceToken / listDeviceTokens / deleteDeviceToken), изоляция пользователей, язык по Accept-Language, валидация. Запуск: make newman SERVICE=notification (AUTH_MODE=dev). Сквозной сценарий заказ → Kafka → push — postman/e2e, папка 13 (make notification-e2e).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088"
    },
    {
      "key": "runId",
      "value": "run"
    },
    {
      "key": "tokA",
      "value": ""
    },
    {
      "key": "tokenA",
      "value": ""
    },
    {
      "key": "tokenB",
      "value": ""
    },
    {
      "key": "tokenC",
      "value": ""
    },
    {
      "key": "registeredAt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "liveness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('status OK', () => pm.expect(pm.response.json().status).to.eql('OK'));"
            ]
          }
        }
      ]
    },
