      ]
    },
    {
      "name": "registerDeviceToken: новый fcm-токен, Accept-Language: en → 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User-Id",
            "value": "alice-{{runId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "CUSTOMER"
          },
          {
            "key": "Accept-Language",
            "value": "en-US,en;q=0.9"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notifications/device-tokens",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"platform\": \"fcm\",\n  \"token\": \"{{tokA}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('runId') || pm.collectionVariables.get('runId') === 'run') { pm.collectionVariables.set('runId', 'r' + Date.now()); }",
              "pm.collectionVariables.set('tokA', 'nt-fcm-' + pm.collectionVariables.get('runId'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('поля токена', () => { pm.expect(j.id).to.match(/^[0-9a-f-]{36}$/); pm.expect(j.platform).to.eql('fcm'); pm.expect(j.permissionsGranted).to.eql(true); pm.expect(j.locale).to.eql('en'); pm.expect(j.registeredAt).to.be.a('string'); });",
              "pm.test('токен совпадает с отправленным', () => pm.expect(j.token).to.eql(pm.collectionVariables.get('tokA')));",
              "pm.test('Location указывает на токен', () => pm.expect(pm.response.headers.get('Location') || '').to.include(j.id));",
              "pm.collectionVariables.set('tokenA', j.id); pm.collectionVariables.set('registeredAt', j.registeredAt);"
            ]
          }
        }
      ]
    },
    {
      "name": "registerDeviceToken: повтор того же токена → 200, тот же id, язык обновлён, registeredAt прежний",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User-Id",
            "value": "alice-{{runId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "CUSTOMER"
          },
          {
            "key": "Accept-Language",
            "value": "ru"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notifications/device-tokens",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"platform\": \"fcm\",\n  \"token\": \"{{tokA}}\",\n  \"permissionsGranted\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('id и registeredAt прежние', () => { pm.expect(j.id).to.eql(pm.collectionVariables.get('tokenA')); pm.expect(j.registeredAt).to.eql(pm.collectionVariables.get('registeredAt')); });",
              "pm.test('язык обновлён, разрешения выключены', () => { pm.expect(j.locale).to.eql('ru'); pm.expect(j.permissionsGranted).to.eql(false); });"
            ]
          }
        }
      ]
    },
