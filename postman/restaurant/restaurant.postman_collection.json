          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "metrics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/metrics",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('RED-метрики', () => pm.expect(pm.response.text()).to.include('http_requests_total'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Поиск (UC-FND-01)",
      "item": [
        {
          "name": "по координатам: 3 активных ресторана Москвы, по расстоянию",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants?lat=55.7558&lon=37.6173&radiusMeters=5000",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('схема страницы', () => {",
                  "  pm.expect(b.items).to.be.an('array'); pm.expect(b.total).to.eql(3);",
                  "  pm.expect(b.limit).to.eql(20); pm.expect(b.offset).to.eql(0);",
                  "  pm.expect(b.center).to.eql({lat: 55.7558, lon: 37.6173});",
                  "  pm.expect(b).to.not.have.property('hint');",
                  "});",
                  "pm.test('схема ресторана', () => b.items.forEach(r => {",
                  "  pm.expect(r.id).to.match(/^[0-9a-f-]{36}$/);",
                  "  pm.expect(r.name).to.be.a('string'); pm.expect(r.city).to.eql('Москва');",
                  "  pm.expect(r.location.lat).to.be.a('number'); pm.expect(r.location.lon).to.be.a('number');",
                  "  pm.expect(Number.isInteger(r.distanceMeters)).to.be.true;",
                  "  pm.expect(r.deliveryAvailable).to.be.a('boolean'); pm.expect(r.openNow).to.be.a('boolean');",
                  "}));",
                  "pm.test('отсортированы по расстоянию', () => {",
                  "  const d = b.items.map(r => r.distanceMeters);",
                  "  pm.expect(d).to.eql([...d].sort((x, y) => x - y));",
                  "});",
                  "pm.test('неактивный ресторан не виден', () => pm.expect(b.items.map(r => r.name)).to.not.include('BLT Закрыт навсегда'));"
                ]
              }
            }
          ]
        },
        {
          "name": "по адресу (ручной ввод, A1)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants?address=г. Москва, Тверская 12",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('город распознан по справочнику', () => { pm.expect(b.center.lat).to.be.within(55.7, 55.8); pm.expect(b.total).to.eql(3); });"
                ]
              }
            }
          ]
        },
        {
          "name": "без центра: весь активный список по названию",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('5 активных, без расстояний и центра', () => {",
                  "  pm.expect(b.total).to.eql(5); pm.expect(b).to.not.have.property('center');",
                  "  b.items.forEach(r => pm.expect(r).to.not.have.property('distanceMeters'));",
                  "  const n = b.items.map(r => r.name); pm.expect(n).to.eql([...n].sort());",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "openNow: круглосуточный BLT Невский всегда открыт",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants?address=Санкт-Петербург&openNow=true",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Невский в выдаче и открыт', () => {",
                  "  const r = b.items.find(x => x.name === 'BLT Невский'); pm.expect(r).to.exist; pm.expect(r.openNow).to.be.true;",
                  "  b.items.forEach(x => pm.expect(x.openNow).to.be.true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "deliveryOnly: доставка учитывает радиус доставки ресторана",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants?lat=55.7640&lon=37.6050&deliveryOnly=true&radiusMeters=3000",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('все с доставкой; Парк Горького (самовывоз) отсутствует', () => {",
                  "  b.items.forEach(r => pm.expect(r.deliveryAvailable).to.be.true);",
                  "  pm.expect(b.items.map(r => r.name)).to.not.include('BLT Парк Горького');",
                  "  pm.expect(b.items.map(r => r.name)).to.include('BLT Тверская');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "пагинация: limit=1 offset=1",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants?lat=55.7558&lon=37.6173&limit=1&offset=1",
