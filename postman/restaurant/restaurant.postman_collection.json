    {
      "name": "Карточка ресторана",
      "item": [
        {
          "name": "getRestaurant: расписание, таймзона, доставка",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/a1000000-0000-4000-8000-000000000001",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('карточка', () => {",
                  "  pm.expect(r.id).to.eql('a1000000-0000-4000-8000-000000000001'); pm.expect(r.timezone).to.eql('Europe/Moscow');",
                  "  pm.expect(r.deliveryEnabled).to.be.true; pm.expect(r.deliveryRadiusMeters).to.eql(5000);",
                  "  pm.expect(r.openNow).to.be.a('boolean'); pm.expect(r).to.not.have.property('distanceMeters');",
                  "});",
                  "pm.test('режим работы 7 дней, формат HH:MM', () => {",
                  "  pm.expect(r.workingHours).to.have.lengthOf(7);",
                  "  r.workingHours.forEach(h => { pm.expect(h.opensAt).to.match(/^\\d\\d:\\d\\d$/); pm.expect(h.closesAt).to.match(/^(\\d\\d:\\d\\d)$/); });",
                  "});",
                  "pm.test('исключения — массив', () => r.scheduleExceptions.forEach(e => { pm.expect(e.date).to.match(/^\\d{4}-\\d\\d-\\d\\d$/); pm.expect(e.closed).to.be.a('boolean'); }));"
                ]
              }
            }
          ]
        },
        {
          "name": "ночной режим: пятница/суббота закрытие 02:00",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/a1000000-0000-4000-8000-000000000002",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const h = pm.response.json().workingHours;",
                  "pm.test('пт и сб 10:00–02:00 (на следующие сутки)', () => {",
                  "  [5, 6].forEach(d => { const x = h.find(y => y.dayOfWeek === d); pm.expect(x.opensAt).to.eql('10:00'); pm.expect(x.closesAt).to.eql('02:00'); });",
                  "  pm.expect(h.find(y => y.dayOfWeek === 1).closesAt).to.eql('23:00');",
                  "});"
                ]
              }
            }
