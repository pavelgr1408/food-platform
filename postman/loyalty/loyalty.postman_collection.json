{
  "info": {
    "name": "loyalty-service",
    "description": "S8: жизненный цикл акций, права (auth /authorize, в dev — локальные правила), конфликты E2, идемпотентность. Запуск: make newman SERVICE=loyalty (AUTH_MODE=dev). Сквозной сценарий скидка→корзина — postman/e2e (требует Kafka).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8086"
    },
    {
      "key": "runId",
      "value": "run"
    },
    {
      "key": "startsAt",
      "value": ""
    },
    {
      "key": "endsAt",
      "value": ""
    },
    {
      "key": "promoA",
      "value": ""
    },
    {
      "key": "promoB",
      "value": ""
    },
    {
      "key": "promoN",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.collectionVariables.get('runId') === 'run') { const now = Date.now(); pm.collectionVariables.set('runId', 'r' + now); pm.collectionVariables.set('startsAt', new Date(now - 3600e3).toISOString()); pm.collectionVariables.set('endsAt', new Date(now + 30 * 86400e3).toISOString()); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "liveness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
