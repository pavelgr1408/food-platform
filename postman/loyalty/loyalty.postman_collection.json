        "url": "{{baseUrl}}/promotions",
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Скидка 15%\",\"scope\":\"local\",\"restaurantId\":\"a1000000-0000-4000-8000-000000000004\",\"priority\":5,\"startsAt\":\"{{startsAt}}\",\"endsAt\":\"{{endsAt}}\",\"discount\":{\"type\":\"percent\",\"value\":1500},\"conditions\":{\"minSubtotal\":0,\"stackable\":false}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const p = pm.response.json();",
              "pm.test('draft v1', () => { pm.expect(p.status).to.eql('draft'); pm.expect(p.version).to.eql(1); pm.expect(p.currency).to.eql('RUB'); });",
              "pm.test('money as integers', () => pm.expect(pm.response.text()).to.include('\"value\":1500'));",
              "pm.test('Location', () => pm.expect(pm.response.headers.get('Location')).to.eql('/promotions/' + p.id));",
              "pm.collectionVariables.set('promoA', p.id);"
            ]
          }
        }
      ]
    },
