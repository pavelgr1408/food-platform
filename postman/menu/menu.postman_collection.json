                ]
              }
            }
          ]
        },
        {
          "name": "позиция другого ресторана (изоляция по ресторану) → ITEM_NOT_FOUND",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/restaurants/a1000000-0000-4000-8000-000000000004/menu/validation",
