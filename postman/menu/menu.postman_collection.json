    {
      "name": "getMenu",
      "item": [
        {
          "name": "меню ресторана: схема, деньги — целые копейки, ETag",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/menu",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const m = pm.response.json();",
                  "pm.test('заголовки кэширования', () => {",
                  "  pm.expect(pm.response.headers.get('ETag')).to.match(/^\"v\\d+\"$/);",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('public, max-age=30');",
                  "});",
                  "pm.test('схема меню', () => {",
                  "  pm.expect(m.restaurantId).to.eql(pm.collectionVariables.get('restaurantId'));",
                  "  pm.expect(Number.isInteger(m.menuVersion)).to.be.true;",
                  "  pm.expect(m.categories.map(c => c.name)).to.eql(['Бургеры', 'Сэндвичи', 'Напитки', 'Десерты']);",
                  "});",
                  "const all = m.categories.flatMap(c => c.items);",
                  "pm.test('цены — integer-копейки + currency (ADR-13)', () => {",
                  "  all.forEach(i => { pm.expect(Number.isInteger(i.price.amount) && i.price.amount >= 0).to.be.true; pm.expect(i.price.currency).to.eql('RUB');",
                  "    i.modifiers.forEach(x => pm.expect(Number.isInteger(x.price.amount)).to.be.true); });",
                  "  pm.expect(all.find(i => i.name === 'BLT Классик').price.amount).to.eql(34900);",
                  "});",
                  "pm.test('позиция в стоп-листе остаётся в меню с available=false', () => pm.expect(all.find(i => i.name === 'Брауни').available).to.be.false);",
                  "const by = n => all.find(i => i.name === n);",
                  "pm.collectionVariables.set('etag', pm.response.headers.get('ETag'));",
                  "pm.collectionVariables.set('burgerId', by('BLT Классик').id);",
                  "pm.collectionVariables.set('baconId', by('BLT Классик').modifiers.find(x => x.name === 'Двойной бекон').id);",
                  "pm.collectionVariables.set('colaId', by('Кола 0,5').id);",
                  "pm.collectionVariables.set('brownieId', by('Брауни').id);"
                ]
              }
            }
          ]
        },
        {
          "name": "If-None-Match с текущим ETag → 304 без тела",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/menu",
            "header": [
              {
                "key": "If-None-Match",
                "value": "{{etag}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 304', () => pm.response.to.have.status(304));",
                  "pm.test('тело пустое, ETag на месте', () => { pm.expect(pm.response.text()).to.eql(''); pm.expect(pm.response.headers.get('ETag')).to.eql(pm.collectionVariables.get('etag')); });"
                ]
              }
            }
          ]
        },
