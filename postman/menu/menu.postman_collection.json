    {
      "name": "validateMenuItems",
      "item": [
        {
          "name": "всё доступно: цены с модификаторами и итог в копейках",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/menu/validation",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"items\":[{\"menuItemId\":\"{{burgerId}}\",\"quantity\":2,\"modifierIds\":[\"{{baconId}}\"]},{\"menuItemId\":\"{{colaId}}\",\"quantity\":3}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const burger = 34900, bacon = 8900, cola = 12900;",
                  "pm.test('valid, версия меню, итог = 2×(бургер+бекон) + 3×кола', () => {",
                  "  pm.expect(r.valid).to.be.true; pm.expect(Number.isInteger(r.menuVersion)).to.be.true;",
                  "  pm.expect(r.total).to.eql({amount: 2 * (burger + bacon) + 3 * cola, currency: 'RUB'});",
                  "});",
                  "pm.test('строки в порядке запроса, цена за единицу с модификаторами', () => {",
                  "  pm.expect(r.lines.map(l => l.menuItemId)).to.eql([pm.collectionVariables.get('burgerId'), pm.collectionVariables.get('colaId')]);",
                  "  pm.expect(r.lines[0].currentPrice.amount).to.eql(burger + bacon); pm.expect(r.lines[0].lineTotal.amount).to.eql(2 * (burger + bacon));",
                  "  pm.expect(r.lines[1].currentPrice.amount).to.eql(cola); pm.expect(r.lines[1].lineTotal.amount).to.eql(3 * cola);",
                  "  r.lines.forEach(l => { pm.expect(l.available).to.be.true; pm.expect(l).to.not.have.property('reasonCode'); });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E1: позиция в стоп-листе → 200, valid=false, причина",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/menu/validation",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"items\":[{\"menuItemId\":\"{{colaId}}\",\"quantity\":1},{\"menuItemId\":\"{{brownieId}}\",\"quantity\":1}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('valid=false, ITEM_UNAVAILABLE, недоступная строка не входит в итог', () => {",
                  "  pm.expect(r.valid).to.be.false;",
                  "  const bad = r.lines[1]; pm.expect(bad.available).to.be.false; pm.expect(bad.reasonCode).to.eql('ITEM_UNAVAILABLE'); pm.expect(bad.reason).to.be.a('string');",
                  "  pm.expect(r.lines[0].available).to.be.true;",
                  "  pm.expect(r.total.amount).to.eql(r.lines[0].lineTotal.amount);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "позиции нет в меню → ITEM_NOT_FOUND без цены",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/menu/validation",
