{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "image", "port"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "replicas": { "type": "integer", "minimum": 1 },
    "env": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "existingSecret": { "type": "string" },
    "secretVolumes": {
      "type": "array",
      "items": { "type": "object", "required": ["name", "secretName", "mountPath"] }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "migrations": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "ingress": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": { "type": "object", "required": ["path"], "properties": { "pathType": { "enum": ["Prefix", "Exact", "ImplementationSpecific"] } } }
        }
      }
    }
  }
}
