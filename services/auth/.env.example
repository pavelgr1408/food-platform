# Скопируйте в .env (он в .gitignore) и экспортируйте: set -a; . services/auth/.env; set +a
HTTP_PORT=8081
APP_ENV=dev
DATABASE_URL=postgres://auth:auth@localhost:5432/auth?sslmode=disable

# Ключи генерирует `make keys SERVICE=auth` (в git не попадают)
JWT_PRIVATE_KEY_PATH=./services/auth/config/keys/private.pem
JWT_PUBLIC_KEY_PATH=./services/auth/config/keys/public.pem
JWT_ISSUER=restaurant-auth-service
JWT_AUDIENCE=restaurant-api
JWT_KEY_ID=local-dev-key
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=720h
BCRYPT_COST=10
SEED_ON_START=true
# JWT_PREVIOUS_PUBLIC_KEYS=old-kid=/path/old-public.pem   # ротация ключа: старые публичные ключи остаются в JWKS
